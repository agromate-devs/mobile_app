{
  "name": "agromate",
  "private": true,
  "version": "1.0.0",
  "description": "AgroMate",
  "repository": "",
  "license": "UNLICENSED",
  "scripts": {
    "start": "npm run dev",
    "dev": "cross-env NODE_ENV=development vite",
    "build": "cross-env NODE_ENV=production vite build",
    "build-capacitor-ios": "cross-env NODE_ENV=production vite build && npx cap copy ios",
    "build-capacitor-android": "cross-env NODE_ENV=production vite build && npx cap copy android",
    "copysqlwasm": "copyfiles -u 3 node_modules/sql.js/dist/sql-wasm.wasm public/assets",
    "format": "prettier --write  --plugin prettier-plugin-svelte .",
    "postinstall": "cpy --flat ./node_modules/framework7-icons/fonts/*.* ./src/fonts/ && cpy --flat ./node_modules/material-icons/iconfont/*.* ./src/fonts/ && npm run copysqlwasm"
  },
  "pre-commit": [
    "format"
  ],
  "browserslist": [
    "IOS >= 15",
    "Safari >= 15",
    "last 5 Chrome versions",
    "last 5 Firefox versions"
  ],
  "dependencies": {
    "@capacitor-community/sqlite": "^8.0.0",
    "@capacitor-firebase/app": "^8.1.0",
    "@capacitor-firebase/authentication": "^8.1.0",
    "@capacitor/android": "^8.1.0",
    "@capacitor/app": "8.0.1",
    "@capacitor/browser": "^8.0.1",
    "@capacitor/core": "^8.1.0",
    "@capacitor/ios": "^8.1.0",
    "@capacitor/keyboard": "^8.0.1",
    "@capacitor/push-notifications": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.1",
    "@tsconfig/svelte": "^5.0.8",
    "chart.js": "^4.5.1",
    "chartjs": "^0.3.24",
    "copyfiles": "^2.4.1",
    "dom7": "^4.0.6",
    "firebase": "^12.10.0",
    "framework7": "^9.0.3",
    "framework7-icons": "^5.0.5",
    "framework7-svelte": "^9.0.3",
    "jeep-sqlite": "^2.8.0",
    "material-icons": "^1.13.14",
    "skeleton-elements": "^4.0.1",
    "svelte": "5.53.7",
    "svelte-preprocess": "^6.0.3",
    "swiper": "^12.1.2",
    "typeorm": "^0.3.28",
    "typescript": "^5.9.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.1.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "cordova-res": "^0.15.4",
    "cpy-cli": "^7.0.0",
    "cross-env": "^10.1.0",
    "postcss-preset-env": "^11.2.0",
    "pre-commit": "^1.2.2",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.1",
    "vite": "^7.3.1"
  }
}